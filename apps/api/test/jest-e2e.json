{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "moduleNameMapper": {
    "^@hospitalityos/shared$": "<rootDir>/../../packages/shared/src"
  },
  "testEnvironment": "node",
  "testTimeout": 30000
}
